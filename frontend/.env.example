# Clerk
# Development instances use pk_test_/sk_test_ keys and log a "development keys"
# warning in the browser. Production must use a Clerk production instance (pk_live_/sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: the instance's PEM public key (Dashboard → API keys → JWKS Public Key).
# Lets the proxy verify sessions without fetching JWKS, which speeds up cold starts.
# CLERK_JWT_KEY=
# Opt out of Clerk's SDK telemetry (development instances only) and its startup notice.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Local development
# Extra hostnames allowed to load the dev server, comma-separated (e.g. a tunnel).
# This machine's LAN addresses are allowed automatically — see next.config.ts.
# DEV_ALLOWED_ORIGINS=*.ngrok-free.app

# Postgres (Prisma)
DATABASE_URL=
DIRECT_URL=

# Explore / places
# Set to true only after the Explore migration has been applied to this database.
EXPLORE_DATABASE_ENABLED="false"
# EXPLORE_CATALOG_DIR=data/explore/catalog

# Ola Maps
# Browser map tiles are proxied via /api/maps/ola using OLA_MAPS_API_KEY.
# OLA_MAPS_REQUEST_ORIGIN must be a domain allowlisted in the Ola console
# (http://localhost:3000 for local phone/LAN testing through the proxy).
NEXT_PUBLIC_OLA_MAPS_API_KEY=
OLA_MAPS_API_KEY=
OLA_MAPS_BASE_URL=https://api.olamaps.io
OLA_MAPS_REQUEST_ORIGIN=http://localhost:3000
# Optional path overrides:
# OLA_MAPS_TEXT_SEARCH_PATH=/places/v1/textsearch
# OLA_MAPS_NEARBY_SEARCH_PATH=/places/v1/nearbysearch
# OLA_MAPS_DETAILS_PATH=/places/v1/details
# OLA_MAPS_ADVANCED_DETAILS_PATH=/places/v1/details/advanced
# OLA_MAPS_PHOTO_PATH=/places/v1/photo

# Optional image enrichment
# ANAKIN_API_KEY=
